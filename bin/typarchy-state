#!/usr/bin/python3 -I
"""Read and write Typarchy's state files without trusting their paths.

    typarchy-state read  identity|profile [--dev]   prints the file's JSON (or {})
    typarchy-state write identity|profile [--dev]   reads one JSON line on stdin

Files live in ~/.local/state/typarchy (typarchy-dev with --dev), 0700 directory,
0600 files. Every open is O_NOFOLLOW relative to a held directory descriptor,
checked with fstat, read up to a byte cap, and validated against a fixed schema;
writes go to an exclusive random temporary that is renamed into place.
"""
import json
import os
import pwd
import re
import secrets
import stat
import sys

MAX_BYTES = 16384
NAME = re.compile(r"[A-Za-z0-9_-]{3,16}")
TOKEN = re.compile(r"[0-9a-f]{64}")
WORD = re.compile(r"[a-z]{1,32}")
MAX_PRACTICE_WORDS = 400
MAX_SCORE = 10**9
_COMPONENT = re.compile(r"[A-Za-z0-9._-]+")


class Refused(Exception):
    pass


def state_parts(dev):
    """Directory chain below the passwd home. $HOME is not the trust anchor."""
    home = pwd.getpwuid(os.geteuid()).pw_dir
    base = [".local", "state"]
    xdg = os.environ.get("XDG_STATE_HOME", "")
    if xdg.startswith(home.rstrip("/") + "/"):
        base = [p for p in xdg[len(home):].split("/") if p]
    parts = base + ["typarchy-dev" if dev else "typarchy"]
    if not all(_COMPONENT.fullmatch(p) and p not in (".", "..") for p in parts):
        raise Refused("unexpected state directory")
    return home, parts


def open_state_dir(dev):
    home, parts = state_parts(dev)
    # The home itself may be a symlink (user setup), so only the anchor follows links.
    fd = os.open(home, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for i, name in enumerate(parts):
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            try:
                nfd = os.open(name, flags, dir_fd=fd)
            except FileNotFoundError:
                try:
                    os.mkdir(name, 0o700, dir_fd=fd)
                except FileExistsError:
                    pass
                nfd = os.open(name, flags, dir_fd=fd)
            os.close(fd)
            fd = nfd
            st = os.fstat(fd)
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
                raise Refused(f"untrusted directory {name}")
            if i == len(parts) - 1 and st.st_mode & 0o077:
                os.fchmod(fd, 0o700)
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_file(dirfd, name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    except FileNotFoundError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_nlink != 1:
            raise Refused(f"{name} is not a plain file owned by you")
        if st.st_size > MAX_BYTES:
            raise Refused(f"{name} is larger than {MAX_BYTES} bytes")
        # Files from 0.2.0 were created 0644; tighten through the descriptor we hold.
        if st.st_mode & 0o077:
            os.fchmod(fd, 0o600)
        os.set_blocking(fd, True)
        data = b""
        while len(data) <= MAX_BYTES:
            chunk = os.read(fd, MAX_BYTES + 1 - len(data))
            if not chunk:
                break
            data += chunk
        if len(data) > MAX_BYTES:
            raise Refused(f"{name} grew past {MAX_BYTES} bytes")
        return data
    finally:
        os.close(fd)


def write_file(dirfd, name, data):
    tmp = f".{name}.{secrets.token_hex(8)}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dirfd)
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
        os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise
    finally:
        os.close(fd)


def whole_number(value, low, high):
    return type(value) is int and low <= value <= high


def clean(kind, doc):
    """The only shapes that are ever stored or handed to the shell."""
    if not isinstance(doc, dict):
        raise Refused("expected a JSON object")
    name = doc.get("name", "")
    if name != "" and not (isinstance(name, str) and NAME.fullmatch(name)):
        raise Refused("bad nickname")
    if kind == "identity":
        token = doc.get("token", "")
        if token != "" and not (isinstance(token, str) and TOKEN.fullmatch(token)):
            raise Refused("bad token")
        if bool(name) != bool(token):
            raise Refused("nickname and token go together")
        return {"name": name, "token": token} if name else {}
    best = doc.get("bestScore", 0)
    rank = doc.get("rank")
    words = doc.get("practiceWords", [])
    if not whole_number(best, 0, MAX_SCORE):
        raise Refused("bad bestScore")
    if rank is not None and not whole_number(rank, 1, MAX_SCORE):
        raise Refused("bad rank")
    if not (isinstance(words, list) and len(words) <= MAX_PRACTICE_WORDS
            and all(isinstance(w, str) and WORD.fullmatch(w) for w in words)):
        raise Refused("bad practiceWords")
    return {"name": name, "bestScore": best, "rank": rank, "practiceWords": words}


def main(argv):
    if len(argv) not in (3, 4) or argv[1] not in ("read", "write") or argv[2] not in ("identity", "profile"):
        print("usage: typarchy-state read|write identity|profile [--dev]", file=sys.stderr)
        return 2
    if len(argv) == 4 and argv[3] != "--dev":
        return 2
    op, kind, dev = argv[1], argv[2], len(argv) == 4
    name = kind + ".json"
    dirfd = open_state_dir(dev)
    try:
        if op == "read":
            raw = read_file(dirfd, name)
            doc = clean(kind, json.loads(raw.decode("utf-8"))) if raw else {}
            sys.stdout.write(json.dumps(doc, separators=(",", ":")) + "\n")
        else:
            line = sys.stdin.buffer.readline(MAX_BYTES + 1)
            if len(line) > MAX_BYTES:
                raise Refused("payload too large")
            doc = clean(kind, json.loads(line.decode("utf-8")))
            write_file(dirfd, name, (json.dumps(doc, separators=(",", ":")) + "\n").encode())
        return 0
    finally:
        os.close(dirfd)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except (Refused, OSError, ValueError, UnicodeDecodeError) as e:
        print(f"typarchy-state: {e}"[:300], file=sys.stderr)
        sys.exit(1)
